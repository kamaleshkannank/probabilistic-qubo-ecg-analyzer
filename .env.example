# AI provider: gemini (needs key below) | ollama (local, no key) | template (always works, no LLM)
AI_PROVIDER=gemini
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override model (verified default gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
# Optional: fallback models if primary is overloaded (comma-separated)
# GEMINI_FALLBACKS=gemini-3.7-flash,gemini-3.6-flash
# Optional: local Ollama (AI_PROVIDER=ollama) - install from https://ollama.com, then: ollama pull llama3.1
# OLLAMA_MODEL=llama3.1
# OLLAMA_HOST=http://localhost:11434
# Optional: move MIT-BIH disk cache off a full drive
# MITBIH_CACHE_DIR=D:/ecg_cache/mitbih
